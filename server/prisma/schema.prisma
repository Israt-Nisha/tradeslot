generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ChannelType {
  WEB_CHAT
  WHATSAPP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum SenderType {
  TRADER
  CUSTOMER
  SYSTEM
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Trader {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  passwordHash    String
  phone           String?
  stripeAccountId String?
  stripeOnboarded Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workAreas WorkArea[]
  bookings  Booking[]
  messages  Message[]

  @@map("traders")
}

model Customer {
  id          String   @id @default(uuid())
  name        String?
  contactInfo String   // Phone number (for WhatsApp) or session/cookie ID (for Web Chat)
  channelId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Restrict)
  bookings Booking[]
  messages Message[]

  @@unique([contactInfo, channelId])
  @@map("customers")
}

model Channel {
  id        String      @id @default(uuid())
  name      String
  type      ChannelType
  config    Json?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages  Message[]
  bookings  Booking[]
  customers Customer[]

  @@map("channels")
}

model WorkArea {
  id          String   @id @default(uuid())
  traderId    String
  areaDetails String
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trader   Trader    @relation(fields: [traderId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([traderId, date])
  @@map("work_areas")
}

model Booking {
  id             String        @id @default(uuid())
  traderId       String
  customerId     String
  channelId      String
  workAreaId     String?
  
  requestedSlot  DateTime
  confirmedStart DateTime
  confirmedEnd   DateTime
  
  status         BookingStatus @default(PENDING)
  jobAddress     String?
  notes          String?

  bookingFee          Float
  travelBufferMinutes Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trader   Trader    @relation(fields: [traderId], references: [id], onDelete: Restrict)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Restrict)
  workArea WorkArea? @relation(fields: [workAreaId], references: [id], onDelete: SetNull)

  messages Message[]
  payment  Payment?

  @@index([traderId, confirmedStart])
  @@index([customerId])
  @@map("bookings")
}

model Message {
  id         String           @id @default(uuid())
  channelId  String
  customerId String
  bookingId  String?
  traderId   String?

  direction  MessageDirection
  senderType SenderType
  content    String
  sentAt     DateTime         @default(now())
  externalId String?          @unique

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  trader   Trader?   @relation(fields: [traderId], references: [id], onDelete: SetNull)

  @@index([channelId])
  @@index([customerId])
  @@index([bookingId])
  @@map("messages")
}

model Payment {
  id             String   @id @default(uuid())
  bookingId      String   @unique
  amount         Float
  applicationFee Float

  stripePaymentIntentId String? @unique
  stripeTransferId      String?
  status                PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}
